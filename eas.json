{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://showoff.anggelt-plasencia.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://showoff.anggelt-plasencia.workers.dev"
      }
    },
    "productionTest": {
      "distribution": "internal",
      "environment": "production",
      "channel": "production-test",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://showoff.anggelt-plasencia.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://showoff.anggelt-plasencia.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
