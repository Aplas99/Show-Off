# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_ANON_KEY=your-supabase-anon-key
# Public Cloudflare site (https). Shared showcase links point here and open
# the app when installed (universal/app links, configured in app.config.ts).
# Required for EAS production builds. Also fill in app-links.json.
# EXPO_PUBLIC_SITE_URL=https://your-site.example

# --- External product APIs ---
# Vendor keys belong ONLY in Supabase Edge Function secrets:
# POKEMON_TCG_API_KEY, BARCODE_LOOKUP_API_KEY, BARCODENEST_KEY, and POKEWALLET_API_KEY.
# Deploy catalog-proxy and its rate-limit migration before running this client.
# See docs/catalog-proxy.md. Never add vendor keys as EXPO_PUBLIC_* variables.

# --- Debugging ---
# Set to false to silence [CardScan] OCR logs.
EXPO_PUBLIC_CARD_SCAN_DEBUG=false

# Enhanced OCR uses Supabase Edge Function secrets OCR_SERVICE_URL and
# OCR_SERVICE_TOKEN. Set the same token as OCR_SERVICE_TOKEN on Railway.
# Do not put the Railway URL or bearer token in EXPO_PUBLIC_* app variables.

# --- Apple / Google in-app purchases ---
# Public SDK keys; server API/webhook secrets belong only in Supabase.
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# See docs/iap-memberships.md for products, offerings, and server configuration.
# Stripe/web purchases are deferred for launch.

# --- Google AdMob (eligible adult free-tier users only) ---
# OFF until the store listings and AdMob account are approved. While off,
# the AdMob native SDK is not compiled into the app at all.
# To turn ads on:
#   1. Remove "react-native-google-mobile-ads" from package.json
#      expo.autolinking.exclude.
#   2. Set EXPO_PUBLIC_ADS_ENABLED=true plus the real AdMob app ids below
#      (app.config.ts refuses to build without them).
#   3. Rebuild the native app (new EAS build; not an OTA update).
EXPO_PUBLIC_ADS_ENABLED=false
# ADMOB_ANDROID_APP_ID=ca-app-pub-...~...
# ADMOB_IOS_APP_ID=ca-app-pub-...~...
# Unit ids; unset falls back to Google's test units when ads are on.
# EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-...
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-...
