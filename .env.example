# Copy to .env and fill in real values. Never commit .env.

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_ANON_KEY=your-supabase-anon-key
# Optional after choosing a Cloudflare/public domain; used for native share links.
# EXPO_PUBLIC_SITE_URL=https://your-site.example

# --- External product APIs ---
# Vendor keys belong ONLY in Supabase Edge Function secrets:
# POKEMON_TCG_API_KEY and BARCODE_LOOKUP_API_KEY.
# Deploy catalog-proxy and its rate-limit migration before running this client.
# See docs/catalog-proxy.md. Never add vendor keys as EXPO_PUBLIC_* variables.

# --- Debugging ---
# Set to false to silence [CardScan] OCR logs.
EXPO_PUBLIC_CARD_SCAN_DEBUG=true

# --- PaddleOCR fallback (optional; see server/paddleocr) ---
# Server-side second OCR pass, called only when an on-device scan finds no
# match. Leave unset to disable. For local testing use your PC's LAN IP.
# EXPO_PUBLIC_OCR_FALLBACK_URL=http://192.168.1.20:8787
# EXPO_PUBLIC_OCR_FALLBACK_TOKEN=matching-OCR_SERVICE_TOKEN

# --- Stripe (memberships) ---
# Publishable key only — reserved for a future @stripe/stripe-react-native
# integration. Checkout currently runs in the browser via Edge Functions.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Server-side Stripe secrets are NOT app env vars. Set them on Supabase:
#   npx supabase secrets set \
#     STRIPE_SECRET_KEY=sk_test_... \
#     STRIPE_WEBHOOK_SECRET=whsec_... \
#     STRIPE_PRICE_ID_FOUNDING_CURATOR=price_... \
#     STRIPE_PRICE_ID_CURATOR_MONTHLY=price_... \
#     STRIPE_PRICE_ID_CURATOR_ANNUAL=price_...
# After creating each Price, seed public.membership_tiers with its
# id -> 'curator' mapping (see 20260714090000_add_membership_tiers.sql).

# --- Google AdMob (ads for free-tier users) ---
# Leave unset to use Google's official test ad units (safe, no real ads
# or revenue). App ids live in app.json's react-native-google-mobile-ads
# plugin config, not here — replace those with real AdMob app ids too
# once an AdMob account/app exists.
# EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-...
# EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-...
